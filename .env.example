PORT=8081

# Primary AI provider for chat replies and photo diagnosis.
# (Get key from https://aistudio.google.com)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Fallback AI provider, used when Gemini is unset or fails. Also powers the
# shop price-refresh feature (enabled automatically when this key is set).
# (Get key from https://console.groq.com)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=plantpal

# Auth (JWT) - generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Google Sign-In: the OAuth *Web application* client ID from Google Cloud
# Console (the same value the Flutter app gets as GOOGLE_SERVER_CLIENT_ID).
# Leave empty to disable POST /api/v1/auth/google.
# Several IDs can be comma-separated.
GOOGLE_CLIENT_ID=