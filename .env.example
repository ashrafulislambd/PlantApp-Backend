PORT=8133

# Primary AI provider for chat replies and photo diagnosis.
# (Get key from https://aistudio.google.com)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Fallback AI provider, used when Gemini is unset or fails. Also powers the
# shop price-refresh feature (enabled automatically when this key is set).
# (Get key from https://console.groq.com)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# MongoDB (Atlas - this deployment has no local Mongo container; required,
# docker-compose.yml fails fast if unset)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=plantpal

# Auth (JWT) - generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Google Sign-In: the OAuth *Web application* client ID from Google Cloud
# Console (the same value the Flutter app gets as GOOGLE_SERVER_CLIENT_ID).
# Leave empty to disable POST /api/v1/auth/google.
# Several IDs can be comma-separated.
GOOGLE_CLIENT_ID=

# Needed only for the browser-redirect Google sign-in flow (GET
# /auth/google/callback) - leave both empty to disable just that flow while
# keeping POST /api/v1/auth/google (above) working.
# GOOGLE_CLIENT_SECRET: from the SAME Web OAuth client as GOOGLE_CLIENT_ID
# (Console -> that client -> Client secret).
# GOOGLE_REDIRECT_URI: must exactly match both the URI registered on that
# OAuth client in the Console AND the Flutter app's
# AppConfig.googleRedirectUri default.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://myplantpal.ddns.net/auth/google/callback

# Caddy's public site address (standard HTTPS, port 443 - this VPS is
# dedicated to this backend, so no shared-port workaround is needed).
# Leave unset for local dev; docker-compose.yml's default
# (http://localhost) keeps Caddy from attempting real ACME requests.
CADDY_SITE_ADDRESS=https://myplantpal.ddns.net