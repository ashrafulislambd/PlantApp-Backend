PORT=8080

# Primary AI provider for chat replies and photo diagnosis.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Fallback AI provider, used when Gemini is unset or fails. Also powers the
# unrelated Groq price-refresh feature (enabled automatically when this key is set).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=myplantpal

# Auth (JWT) - generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
