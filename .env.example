PORT=8081

# Primary AI provider for chat replies and photo diagnosis.
# (Get key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Fallback AI provider, used when Gemini is unset or fails.
# Also powers the shop price-refresh feature.
# (Get key from https://console.groq.com)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=myplantpal

# Auth (JWT)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
